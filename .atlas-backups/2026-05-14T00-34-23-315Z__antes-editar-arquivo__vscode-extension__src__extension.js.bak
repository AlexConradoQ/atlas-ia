}

.subtitle {
    color: #a5b4fc;
    margin-bottom: 20px;
}

textarea {
    width: 100%;
    height: 170px;
    background: #111827;
    color: white;
    border: 1px solid #1f9fff;
    border-radius: 12px;
    padding: 15px;
    resize: vertical;
    outline: none;
}

button {
    margin-top: 15px;
    background: #00bcd4;
    color: #020617;
    border: none;
    border-radius: 10px;
    padding: 12px 22px;
    cursor: pointer;
    font-weight: bold;
}

button:hover { filter: brightness(1.15); }

.quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
}

.quick button {
    margin-top: 0;
    background: #111827;
    color: #00e5ff;
    border: 1px solid #00e5ff;
    padding: 8px 12px;
}

#resposta {
    margin-top: 25px;
    background: #111827;
    border: 1px solid #1f9fff;
    border-radius: 12px;
    padding: 20px;
    white-space: pre-wrap;
    min-height: 220px;
    line-height: 1.5;
}

.status {
    color: #22c55e;
    margin-bottom: 15px;
}

.badge {
    display: inline-block;
    background: #0f172a;
    border: 1px solid #22c55e;
    color: #86efac;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 12px;
    margin-bottom: 12px;
}
</style>
</head>

<body>

<h1>ATLAS IA</h1>

<div class="subtitle">
Painel interno do VS Code — Versão Final
</div>

<div class="badge">
Versão Final Ativa: edição pendente, /diff-arquivo, /snapshot, Agent Auto
</div>

<div class="status">
● ATLAS pronta para comando
</div>

<textarea
id="input"
placeholder="Digite aqui. Ex: /ler-arquivo core/ai.js"
></textarea>

<br>

<button onclick="enviar()">Enviar</button>

<div class="quick">
    <button onclick="atalho('/help')">/help</button>
    <button onclick="atalho('/status')">/status</button>
    <button onclick="atalho('/memoria')">/memoria</button>
    <button onclick="atalho('/arquivo-atual')">/arquivo-atual</button>
    <button onclick="atalho('/listar-pastas')">/pastas</button>
    <button onclick="atalho('/listar-arquivos')">/listar</button>
    <button onclick="atalho('/ler-arquivo core/ai.js')">/ler</button>
    <button onclick="atalho('/abrir core/ai.js')">/abrir</button>
    <button onclick="atalho('/buscar-texto askAI')">/buscar</button>
    <button onclick="atalho('/ia-arquivo explique esse arquivo')">/ia-arquivo</button>
    <button onclick="atalho('/backups')">/backups</button>
    <button onclick="atalho('/diff-arquivo scripts/atlas-gemini.js')">/diff</button>
    <button onclick="atalho('/snapshot')">/snapshot</button>
    <button onclick="atalho('/agent criar um módulo simples de exemplo')">/agent</button>
    <button onclick="atalho('/agent-auto criar um módulo simples de exemplo')">/agent-auto</button>
</div>

<div id="resposta">
ATLAS ONLINE

Use /help para ver os comandos.
</div>

<script>
const vscode = acquireVsCodeApi();

function enviar() {
    const input = document.getElementById("input");
    const texto = input.value.trim();

    if (!texto) return;

    document.getElementById("resposta").textContent =
        "ATLAS processando...";

    vscode.postMessage({
        command: "enviar",
        texto
    });
}

function atalho(texto) {
    document.getElementById("input").value = texto;
    enviar();
}

window.addEventListener("message", event => {
    const message = event.data;

    if (message.command === "resposta") {
        document.getElementById("resposta").textContent =
            message.texto;
    }
});
</script>

</body>
</html>
`;
}

module.exports = {
    activate,
    deactivate
};