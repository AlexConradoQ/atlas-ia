const vscode = require("vscode");
const path = require("path");
const fs = require("fs");
const dotenv = require("dotenv");
const { exec } = require("child_process");

const { GoogleGenerativeAI } = require("@google/generative-ai");
const OpenAI = require("openai");

let geminiModel = null;
let openaiClient = null;
let ultimoEditorTexto = null;
let raizAtlas = null;
let planoPendente = null;
let edicaoPendente = null; // { caminhoRelativo, conteudoOriginal, conteudoProposto, instrucao }
let contextoExtensao = null;

function activate(context) {
    console.log("ATLAS ativada.");

    contextoExtensao = context;

    atualizarRaizAtlas();
    configurarGemini();
    configurarOpenAI();

    if (vscode.window.activeTextEditor) {
        ultimoEditorTexto = vscode.window.activeTextEditor;
    }

    vscode.window.onDidChangeActiveTextEditor((editor) => {
        if (editor && editor.document && editor.document.uri.scheme === "file") {
            ultimoEditorTexto = editor;
        }
    });

    vscode.workspace.onDidChangeWorkspaceFolders(() => {
        atualizarRaizAtlas();
        configurarGemini();
        configurarOpenAI();
    });

    const disposable = vscode.commands.registerCommand("atlas.openPanel", () => {
        atualizarRaizAtlas();

        const panel = vscode.window.createWebviewPanel(
            "atlasPanel",
            "ATLAS",
            vscode.ViewColumn.One,
            { enableScripts: true }
        );

        panel.webview.html = getWebviewContent();

        panel.webview.onDidReceiveMessage(async (message) => {
            if (message.command === "enviar") {
                const resposta = await gerarResposta(message.texto);

                panel.webview.postMessage({
                    command: "resposta",
                    texto: resposta
                });
            }
        });
    });

    context.subscriptions.push(disposable);
}

function deactivate() {}

function atualizarRaizAtlas() {
    const workspace = vscode.workspace.workspaceFolders?.[0]?.uri.fsPath;

    if (workspace) {
        if (path.basename(workspace).toLowerCase() === "vscode-extension") {
            raizAtlas = path.dirname(workspace);
        } else {
            raizAtlas = workspace;
        }
    } else if (contextoExtensao) {
        raizAtlas = path.join(contextoExtensao.extensionPath, "..");
    } else {
        raizAtlas = process.cwd();
    }

    dotenv.config({
        path: path.join(raizAtlas, ".env"),
        override: true
    });

    console.log("Raiz ATLAS:", raizAtlas);
}

function configurarGemini() {
    const apiKey = process.env.GEMINI_API_KEY;

    if (!apiKey) {
        console.log("GEMINI_API_KEY não encontrada.");
        geminiModel = null;
        return;
    }

    const genAI = new GoogleGenerativeAI(apiKey);

    geminiModel = genAI.getGenerativeModel({
        model: "gemini-2.5-flash"
    });

    console.log("Gemini conectado.");
}

function configurarOpenAI() {
    const apiKey = process.env.OPENAI_API_KEY;

    if (!apiKey) {
        console.log("OPENAI_API_KEY não encontrada.");
        openaiClient = null;
        return;
    }

    openaiClient = new OpenAI({ apiKey });

    console.log("OpenAI conectada.");
}

function obterEditor() {
    const editorAtual = vscode.window.activeTextEditor;

    if (editorAtual && editorAtual.document && editorAtual.document.uri.scheme === "file") {
        ultimoEditorTexto = editorAtual;
        return editorAtual;
    }

    return ultimoEditorTexto;
}

function obterSelecaoAtual() {
    const editor = obterEditor();

    if (!editor) return null;

    const textoSelecionado = editor.document.getText(editor.selection);

    if (!textoSelecionado.trim()) return null;

    return {
        editor,
        textoSelecionado
    };
}

function caminhoSeguro(caminhoRelativo) {
    atualizarRaizAtlas();

    const caminhoNormalizado = caminhoRelativo.replace(/\\/g, "/").trim() || ".";
    const caminhoFinal = path.resolve(raizAtlas, caminhoNormalizado);
    const raizResolvida = path.resolve(raizAtlas);

    if (!caminhoFinal.startsWith(raizResolvida)) {
        throw new Error("Caminho inválido fora da pasta ATLAS-IA.");
    }

    return caminhoFinal;
}

function caminhoRelativoSeguro(caminhoFinal) {
    atualizarRaizAtlas();
    return path.relative(raizAtlas, caminhoFinal).replace(/\\/g, "/");
}

function estaBloqueadoParaEdicao(caminhoRelativo) {
    const normalizado = caminhoRelativo.replace(/\\/g, "/").toLowerCase();

    const bloqueios = [
        "node_modules/",
        ".git/",
        ".vscode/",
        ".atlas-backups/",
        ".obsidian/",
        ".env",
        "package-lock.json"
    ];

    if (normalizado === ".env") return true;
    if (normalizado.endsWith("/.env")) return true;
    if (normalizado === "package-lock.json") return true;
    if (normalizado.endsWith("/package-lock.json")) return true;

    return bloqueios.some((bloqueio) => normalizado.includes(bloqueio));
}

function validarPodeEditar(caminhoRelativo) {
    if (estaBloqueadoParaEdicao(caminhoRelativo)) {
        throw new Error(`Arquivo bloqueado por segurança: ${caminhoRelativo}`);
    }
}

function obterPastaBackups() {
    const pasta = path.join(raizAtlas, ".atlas-backups");
    fs.mkdirSync(pasta, { recursive: true });
    return pasta;
}

function obterPastaLogs() {
    const pasta = path.join(raizAtlas, "05 - Logs");
    fs.mkdirSync(pasta, { recursive: true });
    return pasta;
}

function registrarAcaoAtlas(tipo, detalhes) {
    try {
        atualizarRaizAtlas();

        const pastaLogs = obterPastaLogs();
        const arquivoLog = path.join(pastaLogs, "atlas-actions.md");
        const data = new Date().toLocaleString("pt-BR");

        const registro = `
## ${data} - ${tipo}

${detalhes}

---
`;

        fs.appendFileSync(arquivoLog, registro, "utf8");
    } catch (erro) {
        console.log("Erro ao registrar ação ATLAS:", erro.message);
    }
}

function criarBackup(caminhoFinal, motivo = "backup") {
    atualizarRaizAtlas();

    if (!fs.existsSync(caminhoFinal)) return null;
    if (fs.statSync(caminhoFinal).isDirectory()) return null;

    const relativo = caminhoRelativoSeguro(caminhoFinal);

    if (estaBloqueadoParaEdicao(relativo)) {
        return null;
    }

    const pastaBackups = obterPastaBackups();

    const timestamp = new Date()
        .toISOString()
        .replace(/:/g, "-")
        .replace(/\./g, "-");

    const nomeSeguro = relativo.replace(/[\\/]/g, "__");
    const nomeBackup = `${timestamp}__${motivo}__${nomeSeguro}.bak`;
    const caminhoBackup = path.join(pastaBackups, nomeBackup);

    fs.copyFileSync(caminhoFinal, caminhoBackup);

    registrarAcaoAtlas(
        "BACKUP CRIADO",
        `ARQUIVO ORIGINAL:\n${relativo}\n\nBACKUP:\n.atlas-backups/${nomeBackup}\n\nMOTIVO:\n${motivo}`
    );

    return nomeBackup;
}

function listarBackups() {
    atualizarRaizAtlas();

    const pastaBackups = obterPastaBackups();

    const arquivos = fs
        .readdirSync(pastaBackups)
        .filter((arquivo) => arquivo.endsWith(".bak"))
        .sort()
        .reverse();

    return arquivos;
}

function extrairArquivoOriginalDoBackup(nomeBackup) {
    const partes = nomeBackup.split("__");

    if (partes.length < 3) {
        throw new Error("Nome de backup inválido.");
    }

    const partesArquivo = partes.slice(2);
    let relativo = partesArquivo.join("/");

    if (relativo.endsWith(".bak")) {
        relativo = relativo.slice(0, -4);
    }

    return relativo;
}

async function restaurarBackup(comando) {
    atualizarRaizAtlas();

    const argumento = comando.replace(/^\/restaurar-backup\s*/i, "").trim();
    const backups = listarBackups();

    if (!argumento) {
        if (!backups.length) {
            return "Nenhum backup encontrado em .atlas-backups.";
        }

        return `
BACKUPS DISPONÍVEIS

Use:

/restaurar-backup nome-do-backup

ÚLTIMOS BACKUPS:

${backups.slice(0, 20).join("\n")}
`;
    }

    const nomeBackup = argumento;
    const caminhoBackup = path.join(obterPastaBackups(), nomeBackup);

    if (!fs.existsSync(caminhoBackup)) {
        return `
Backup não encontrado:

${nomeBackup}
`;
    }

    const arquivoOriginal = extrairArquivoOriginalDoBackup(nomeBackup);
    validarPodeEditar(arquivoOriginal);

    const caminhoOriginal = caminhoSeguro(arquivoOriginal);

    if (fs.existsSync(caminhoOriginal)) {
        criarBackup(caminhoOriginal, "antes-restaurar-backup");
    }

    fs.mkdirSync(path.dirname(caminhoOriginal), { recursive: true });
    fs.copyFileSync(caminhoBackup, caminhoOriginal);

    const documento = await vscode.workspace.openTextDocument(caminhoOriginal);
    await vscode.window.showTextDocument(documento);

    registrarAcaoAtlas(
        "BACKUP RESTAURADO",
        `BACKUP:\n${nomeBackup}\n\nARQUIVO RESTAURADO:\n${arquivoOriginal}`
    );

    return `
Backup restaurado com sucesso.

BACKUP:
${nomeBackup}

ARQUIVO:
${arquivoOriginal}
`;
}

function lerArquivosMarkdownRecursivo(caminhoPasta) {
    let conteudoCompleto = "";

    if (!fs.existsSync(caminhoPasta)) return conteudoCompleto;

    const itens = fs.readdirSync(caminhoPasta, { withFileTypes: true });

    for (const item of itens) {
        const caminhoItem = path.join(caminhoPasta, item.name);

        if (
            item.name === "node_modules" ||
            item.name === ".git" ||
            item.name === ".vscode" ||
            item.name === ".atlas-backups"
        ) {
            continue;
        }

        if (item.isDirectory()) {
            conteudoCompleto += lerArquivosMarkdownRecursivo(caminhoItem);
        }

        if (item.isFile() && item.name.endsWith(".md")) {
            const conteudo = fs.readFileSync(caminhoItem, "utf8");

            conteudoCompleto += `

ARQUIVO: ${path.relative(raizAtlas, caminhoItem)}

${conteudo}

`;
        }
    }

    return conteudoCompleto;
}

function carregarMemoria() {
    atualizarRaizAtlas();

    const pastasMemoria = [
        "00 - Sistema",
        "01 - Memória",
        "02 - Projetos",
        "03 - Conhecimento",
        "04 - Prompts",
        "05 - Logs"
    ];

    let memoriaCompleta = "";

    for (const pasta of pastasMemoria) {
        memoriaCompleta += lerArquivosMarkdownRecursivo(
            path.join(raizAtlas, pasta)
        );
    }

    return memoriaCompleta;
}

function salvarMemoria(comando) {
    const texto = comando.replace(/^\/salvar-memoria\s*/i, "").trim();

    if (!texto) {
        return `
Formato correto:

/salvar-memoria texto importante para lembrar
`;
    }

    const pastaMemoria = caminhoSeguro("01 - Memória");
    const arquivoMemoria = path.join(pastaMemoria, "memoria-principal.md");

    fs.mkdirSync(pastaMemoria, { recursive: true });

    const data = new Date().toLocaleString("pt-BR");

    const registro = `

## Registro automático - ${data}

${texto}

`;

    fs.appendFileSync(arquivoMemoria, registro, "utf8");

    registrarAcaoAtlas(
        "MEMÓRIA SALVA",
        `ARQUIVO:\n01 - Memória/memoria-principal.md\n\nCONTEÚDO:\n${texto}`
    );

    return `
Memória salva com sucesso.

ARQUIVO:
01 - Memória/memoria-principal.md
`;
}

function limparComandoIA(comando) {
    return comando
        .replace(/^\/chatgpt\s*/i, "")
        .replace(/^\/gemini\s*/i, "")
        .replace(/^\/atlas\s*/i, "")
        .trim();
}

function identificarProvider(comando) {
    const texto = comando.trim().toLowerCase();

    if (texto.startsWith("/chatgpt")) return "openai";
    if (texto.startsWith("/gemini")) return "gemini";
    if (texto.startsWith("/atlas")) return "auto";

    return "gemini";
}

async function chamarGemini(prompt) {
    if (!geminiModel) {
        return `
Gemini não conectado.

Verifique o arquivo .env na raiz do projeto:

GEMINI_API_KEY=sua_chave

Raiz atual:
${raizAtlas}
`;
    }

    try {
        const resultado = await geminiModel.generateContent(prompt);
        const resposta = await resultado.response;

        return resposta.text();
    } catch (erro) {
        console.log(erro);

        return `
Erro ao acessar Gemini.

Detalhe:
${erro.message}
`;
    }
}

async function chamarOpenAI(prompt) {
    if (!openaiClient) {
        return `
OpenAI não conectada.

Verifique o arquivo .env:

OPENAI_API_KEY=sua_chave
OPENAI_MODEL=gpt-5.5
`;
    }

    try {
        const modelo = process.env.OPENAI_MODEL || "gpt-5.5";

        const resposta = await openaiClient.responses.create({
            model: modelo,
            input: prompt
        });

        return resposta.output_text || "OpenAI respondeu sem texto.";
    } catch (erro) {
        console.log(erro);

        const mensagemErro = erro.message || "";

        if (
            erro.status === 429 ||
            mensagemErro.includes("429") ||
            mensagemErro.toLowerCase().includes("quota")
        ) {
            return await chamarGemini(`
A OpenAI está sem quota/billing no momento.
Continue a tarefa usando Gemini como fallback.

PROMPT ORIGINAL:
${prompt}
`);
        }

        return `
Erro ao acessar OpenAI.

Detalhe:
${erro.message}
`;
    }
}

async function chamarIA(textoUsuario, provider = "auto") {
    atualizarRaizAtlas();

    const memoria = carregarMemoria();

    let providerFinal = provider;

    if (providerFinal === "auto") {
        providerFinal = identificarProvider(textoUsuario);
    }

    const prompt = `
Você é a ATLAS IA, assistente local do Alexander dentro do VS Code.

IDENTIDADE:
- Você ajuda com projetos, código, organização, arquitetura e estudos.
- Responda sempre em português brasileiro.
- Seja direto, prático e organizado.
- Quando o usuário pedir código, entregue código completo.
- Não mande pequenos trechos soltos.
- Não invente arquivos que você não viu.
- Use a memória local quando ela ajudar.

RAIZ DO PROJETO:
${raizAtlas}

MEMÓRIA LOCAL:
${memoria}

PEDIDO DO USUÁRIO:
${textoUsuario}
`;

    if (providerFinal === "openai") {
        return await chamarOpenAI(prompt);
    }

    return await chamarGemini(prompt);
}

function extrairCodigoLimpo(texto) {
    const match = texto.match(/```(?:\w+)?\n([\s\S]*?)```/);

    if (match && match[1]) {
        return match[1].trim();
    }

    return texto.trim();
}

function extensaoPermitidaParaLeitura(nomeArquivo) {
    const extensoesPermitidas = [
        ".js",
        ".json",
        ".md",
        ".html",
        ".css",
        ".txt",
        ".env",
        ".yml",
        ".yaml",
        ".ts",
        ".jsx",
        ".tsx"
    ];

    return extensoesPermitidas.includes(path.extname(nomeArquivo).toLowerCase());
}

function listarArquivosRecursivo(caminhoPasta, limite = 180) {
    const resultados = [];

    function andar(pasta) {
        if (resultados.length >= limite) return;
        if (!fs.existsSync(pasta)) return;

        const itens = fs.readdirSync(pasta, { withFileTypes: true });

        for (const item of itens) {
            if (resultados.length >= limite) break;

            if (
                item.name === "node_modules" ||
                item.name === ".git" ||
                item.name === ".vscode" ||
                item.name === ".atlas-backups"
            ) {
                continue;
            }

            const caminhoItem = path.join(pasta, item.name);
            const relativo = path.relative(raizAtlas, caminhoItem);

            if (item.isDirectory()) {
                resultados.push(`📁 ${relativo}`);
                andar(caminhoItem);
            } else {
                resultados.push(`📄 ${relativo}`);
            }
        }
    }

    andar(caminhoPasta);

    return resultados.join("\n");
}

function listarPastasRecursivo(caminhoPasta, limite = 120) {
    const resultados = [];

    function andar(pasta, nivel = 0) {
        if (resultados.length >= limite) return;
        if (!fs.existsSync(pasta)) return;

        const itens = fs.readdirSync(pasta, { withFileTypes: true });

        for (const item of itens) {
            if (resultados.length >= limite) break;

            if (
                item.name === "node_modules" ||
                item.name === ".git" ||
                item.name === ".vscode" ||
                item.name === ".atlas-backups"
            ) {
                continue;
            }

            const caminhoItem = path.join(pasta, item.name);

            if (item.isDirectory()) {
                const relativo = path.relative(raizAtlas, caminhoItem);
                resultados.push(`${"  ".repeat(nivel)}📁 ${relativo}`);
                andar(caminhoItem, nivel + 1);
            }
        }
    }

    andar(caminhoPasta);

    return resultados.join("\n");
}

function buscarTextoRecursivo(caminhoPasta, termo, limite = 80) {
    const resultados = [];

    function andar(pasta) {
        if (resultados.length >= limite) return;
        if (!fs.existsSync(pasta)) return;

        const itens = fs.readdirSync(pasta, { withFileTypes: true });

        for (const item of itens) {
            if (resultados.length >= limite) break;

            if (
                item.name === "node_modules" ||
                item.name === ".git" ||
                item.name === ".vscode" ||
                item.name === ".atlas-backups"
            ) {
                continue;
            }

            const caminhoItem = path.join(pasta, item.name);

            if (item.isDirectory()) {
                andar(caminhoItem);
                continue;
            }

            if (!extensaoPermitidaParaLeitura(item.name)) {
                continue;
            }

            const conteudo = fs.readFileSync(caminhoItem, "utf8");

            if (conteudo.toLowerCase().includes(termo.toLowerCase())) {
                resultados.push(path.relative(raizAtlas, caminhoItem));
            }
        }
    }

    andar(caminhoPasta);

    return resultados;
}

function obterResumoProjeto() {
    atualizarRaizAtlas();

    const estrutura = listarArquivosRecursivo(raizAtlas, 220);
    const pastas = listarPastasRecursivo(raizAtlas, 120);

    return `
RAIZ:
${raizAtlas}

PASTAS:
${pastas}

ESTRUTURA:
${estrutura}
`;
}

async function abrirArquivo(comando) {
    const caminhoRelativo = comando.replace(/^\/abrir\s*/i, "").trim();

    if (!caminhoRelativo) {
        return `
Formato correto:

/abrir caminho/do/arquivo.js
`;
    }

    const caminhoFinal = caminhoSeguro(caminhoRelativo);

    if (!fs.existsSync(caminhoFinal)) {
        return `
Arquivo não encontrado:

${caminhoRelativo}
`;
    }

    if (fs.statSync(caminhoFinal).isDirectory()) {
        return "Esse caminho é uma pasta. Use um arquivo.";
    }

    const documento = await vscode.workspace.openTextDocument(caminhoFinal);
    await vscode.window.showTextDocument(documento);

    return `
Arquivo aberto com sucesso.

CAMINHO:
${path.relative(raizAtlas, caminhoFinal)}
`;
}

async function abrirMultiplosArquivos(comando) {
    const conteudoComando = comando.replace(/^\/abrir-multiplos\s*/i, "").trim();

    if (!conteudoComando.includes("|")) {
        return `
Formato correto:

/abrir-multiplos core/ai.js | core/files.js | core/logs.js
`;
    }

    const arquivos = conteudoComando
        .split("|")
        .map((item) => item.trim())
        .filter(Boolean);

    if (!arquivos.length) {
        return "Nenhum arquivo informado.";
    }

    const abertos = [];
    const erros = [];

    for (const arquivo of arquivos) {
        try {
            const caminhoFinal = caminhoSeguro(arquivo);

            if (!fs.existsSync(caminhoFinal)) {
                erros.push(`Não encontrado: ${arquivo}`);
                continue;
            }

            if (fs.statSync(caminhoFinal).isDirectory()) {
                erros.push(`É uma pasta, não arquivo: ${arquivo}`);
                continue;
            }

            const documento = await vscode.workspace.openTextDocument(caminhoFinal);
            await vscode.window.showTextDocument(documento, { preview: false });

            abertos.push(arquivo);
        } catch (erro) {
            erros.push(`${arquivo}: ${erro.message}`);
        }
    }

    return `
ABRIR MÚLTIPLOS

ARQUIVOS ABERTOS:
${abertos.length ? abertos.join("\n") : "(nenhum)"}

ERROS:
${erros.length ? erros.join("\n") : "(sem erros)"}
`;
}

function lerArquivo(comando) {
    const caminhoRelativo = comando.replace(/^\/ler-arquivo\s*/i, "").trim();

    if (!caminhoRelativo) {
        return `
Formato correto:

/ler-arquivo caminho/do/arquivo.js
`;
    }

    const caminhoFinal = caminhoSeguro(caminhoRelativo);

    if (!fs.existsSync(caminhoFinal)) {
        return `
Arquivo não encontrado:

${caminhoRelativo}
`;
    }

    if (fs.statSync(caminhoFinal).isDirectory()) {
        return "Esse caminho é uma pasta. Use um arquivo.";
    }

    if (!extensaoPermitidaParaLeitura(caminhoFinal)) {
        return "Tipo de arquivo não permitido para leitura.";
    }

    const conteudo = fs.readFileSync(caminhoFinal, "utf8");

    const limite = 25000;
    const conteudoLimitado =
        conteudo.length > limite
            ? conteudo.slice(0, limite) + "\n\n[ARQUIVO CORTADO POR LIMITE DE TAMANHO]"
            : conteudo;

    return `
ARQUIVO:
${path.relative(raizAtlas, caminhoFinal)}

TAMANHO:
${conteudo.length} caracteres

CONTEÚDO:
${conteudoLimitado}
`;
}

async function criarArquivo(comando) {
    const conteudoComando = comando.replace(/^\/criar-arquivo\s*/i, "").trim();

    if (!conteudoComando.includes("|")) {
        return `
Formato correto:

/criar-arquivo caminho/do/arquivo.js | conteúdo do arquivo
`;
    }

    const [caminhoRelativo, ...partesConteudo] = conteudoComando.split("|");
    const relativo = caminhoRelativo.trim();
    const conteudo = partesConteudo.join("|").trim();

    validarPodeEditar(relativo);

    const caminhoFinal = caminhoSeguro(relativo);
    const pastaFinal = path.dirname(caminhoFinal);

    if (fs.existsSync(caminhoFinal)) {
        criarBackup(caminhoFinal, "antes-criar-arquivo-sobrescrever");
    }

    fs.mkdirSync(pastaFinal, { recursive: true });
    fs.writeFileSync(caminhoFinal, conteudo, "utf8");

    registrarAcaoAtlas(
        "ARQUIVO CRIADO",
        `CAMINHO:\n${path.relative(raizAtlas, caminhoFinal)}`
    );

    return `
Arquivo criado com sucesso.

CAMINHO:
${path.relative(raizAtlas, caminhoFinal)}
`;
}

async function editarArquivo(comando) {
    const conteudoComando = comando.replace(/^\/editar-arquivo\s*/i, "").trim();

    if (!conteudoComando.includes("|")) {
        return `
Formato correto:

/editar-arquivo caminho/do/arquivo.js | instrução da edição
`;
    }

    const [caminhoRelativo, ...partesInstrucao] = conteudoComando.split("|");
    const relativo = caminhoRelativo.trim();
    const instrucao = partesInstrucao.join("|").trim();

    validarPodeEditar(relativo);

    const caminhoFinal = caminhoSeguro(relativo);

    if (!fs.existsSync(caminhoFinal)) {
        return `
Arquivo não encontrado:

${path.relative(raizAtlas, caminhoFinal)}
`;
    }

    const conteudoAtual = fs.readFileSync(caminhoFinal, "utf8");

    const respostaIA = await chamarIA(
        `
Você vai editar um arquivo do projeto.

IMPORTANTE:
- Devolva APENAS o conteúdo final completo do arquivo.
- Não explique fora do código.
- Não use markdown se não for necessário.
- Não coloque comentários extras fora do arquivo.
- Preserve o objetivo original do arquivo.
- Não apague funcionalidades existentes sem necessidade.
- Mantenha o arquivo funcional.

ARQUIVO:
${path.relative(raizAtlas, caminhoFinal)}

CONTEÚDO ATUAL:
${conteudoAtual}

INSTRUÇÃO:
${instrucao}
`,
        "gemini"
    );

    const novoConteudo = extrairCodigoLimpo(respostaIA);

    if (!novoConteudo.trim()) {
        return "A IA retornou conteúdo vazio. Edição cancelada.";
    }

    edicaoPendente = {
        caminhoRelativo: relativo,
        conteudoOriginal: conteudoAtual,
        conteudoProposto: novoConteudo,
        instrucao: instrucao
    };

    return `
EDIÇÃO PENDENTE DE CONFIRMAÇÃO

ARQUIVO:
${relativo}

INSTRUÇÃO:
${instrucao}

Para ver as diferenças, use:
/diff-arquivo ${relativo}

Para confirmar e salvar, digite:
/confirmar-edicao

Para cancelar, digite:
/cancelar-edicao
`;
}

async function confirmarEdicaoPendente() {
    if (!edicaoPendente) {
        return "Não há edição pendente para confirmar.";
    }

    const { caminhoRelativo, conteudoProposto, instrucao } = edicaoPendente;
    const caminhoFinal = caminhoSeguro(caminhoRelativo);

    const backup = criarBackup(caminhoFinal, "antes-confirmar-edicao");

    fs.writeFileSync(caminhoFinal, conteudoProposto, "utf8");

    const documento = await vscode.workspace.openTextDocument(caminhoFinal);
    await vscode.window.showTextDocument(documento);

    registrarAcaoAtlas(
        "ARQUIVO EDITADO (CONFIRMADO)",
        `CAMINHO:\n${caminhoRelativo}\n\nBACKUP:\n${backup || "não criado"}\n\nINSTRUÇÃO:\n${instrucao}`
    );

    edicaoPendente = null;

    return `
Edição confirmada e salva com sucesso.

CAMINHO:
${caminhoRelativo}

BACKUP:
${backup ? `.atlas-backups/${backup}` : "não criado"}
`;
}

function cancelarEdicaoPendente() {
    if (!edicaoPendente) {
        return "Não há edição pendente para cancelar.";
    }

    const caminhoRelativo = edicaoPendente.caminhoRelativo;
    edicaoPendente = null;

    registrarAcaoAtlas(
        "EDIÇÃO CANCELADA",
        `ARQUIVO:\n${caminhoRelativo}`
    );

    return `Edição de ${caminhoRelativo} cancelada.`;
}

async function escreverArquivoCompleto(comando) {
    const match = comando.match(/^\/escrever-arquivo\s+([^\n]+)\n([\s\S]*)$/i);

    if (!match) {
        return `
Formato correto:

/escrever-arquivo caminho/do/arquivo.js
CONTEÚDO COMPLETO DO ARQUIVO
`;
    }

    const relativo = match[1].trim();
    const novoConteudo = match[2];

    validarPodeEditar(relativo);

    if (!novoConteudo.trim()) {
        return "Conteúdo vazio. Escrita cancelada.";
    }

    const caminhoFinal = caminhoSeguro(relativo);

    let backup = null;

    if (fs.existsSync(caminhoFinal)) {
        backup = criarBackup(caminhoFinal, "antes-escrever-arquivo");
    }

    fs.mkdirSync(path.dirname(caminhoFinal), { recursive: true });
    fs.writeFileSync(caminhoFinal, novoConteudo, "utf8");

    const documento = await vscode.workspace.openTextDocument(caminhoFinal);
    await vscode.window.showTextDocument(documento);

    registrarAcaoAtlas(
        "ARQUIVO ESCRITO COMPLETO",
        `CAMINHO:\n${path.relative(raizAtlas, caminhoFinal)}\n\nBACKUP:\n${backup || "não existia arquivo anterior"}`
    );

    return `
Arquivo escrito com sucesso.

CAMINHO:
${path.relative(raizAtlas, caminhoFinal)}

BACKUP:
${backup ? `.atlas-backups/${backup}` : "não existia arquivo anterior"}
`;
}

function deletarArquivo(comando) {
    const caminhoRelativo = comando.replace(/^\/deletar-arquivo\s*/i, "").trim();

    if (!caminhoRelativo) {
        return `
Formato correto:

/deletar-arquivo caminho/do/arquivo.js
`;
    }

    validarPodeEditar(caminhoRelativo);

    const caminhoFinal = caminhoSeguro(caminhoRelativo);

    if (!fs.existsSync(caminhoFinal)) {
        return `Arquivo não encontrado: ${caminhoRelativo}`;
    }

    if (fs.statSync(caminhoFinal).isDirectory()) {
        return "Por segurança, este comando não deleta pastas.";
    }

    const backup = criarBackup(caminhoFinal, "antes-deletar-arquivo");

    fs.unlinkSync(caminhoFinal);

    registrarAcaoAtlas(
        "ARQUIVO DELETADO",
        `CAMINHO:\n${caminhoRelativo}\n\nBACKUP:\n${backup || "não criado"}`
    );

    return `
Arquivo deletado com sucesso.

CAMINHO:
${caminhoRelativo}

BACKUP:
${backup ? `.atlas-backups/${backup}` : "não criado"}
`;
}

function substituirTexto(comando) {
    const conteudoComando = comando.replace(/^\/substituir-texto\s*/i, "").trim();

    if (!conteudoComando.includes("|")) {
        return `
Formato correto:

/substituir-texto arquivo.js | texto antigo | texto novo
`;
    }

    const partes = conteudoComando.split("|").map(p => p.trim());

    if (partes.length < 3) {
        return `
Formato correto:

/substituir-texto arquivo.js | texto antigo | texto novo
`;
    }

    const relativo = partes[0];

    validarPodeEditar(relativo);

    const caminhoFinal = caminhoSeguro(relativo);
    const antigo = partes[1];
    const novo = partes.slice(2).join("|");

    if (!fs.existsSync(caminhoFinal)) {
        return `Arquivo não encontrado: ${partes[0]}`;
    }

    const conteudoAtual = fs.readFileSync(caminhoFinal, "utf8");

    if (!conteudoAtual.includes(antigo)) {
        return `Texto antigo não encontrado no arquivo: ${partes[0]}`;
    }

    const backup = criarBackup(caminhoFinal, "antes-substituir-texto");

    const atualizado = conteudoAtual.split(antigo).join(novo);

    fs.writeFileSync(caminhoFinal, atualizado, "utf8");

    registrarAcaoAtlas(
        "TEXTO SUBSTITUÍDO",
        `ARQUIVO:\n${partes[0]}\n\nBACKUP:\n${backup || "não criado"}\n\nTEXTO ANTIGO:\n${antigo}\n\nTEXTO NOVO:\n${novo}`
    );

    return `
Texto substituído com sucesso.

ARQUIVO:
${partes[0]}

BACKUP:
${backup ? `.atlas-backups/${backup}` : "não criado"}
`;
}

function executarComando(comando, alias = "/executar") {
    const regex = new RegExp(`^${alias}\\s*`, "i");
    const comandoShell = comando.replace(regex, "").trim();

    if (!comandoShell) {
        return Promise.resolve(`
Formato correto:

${alias} comando

Exemplo:
${alias} npm test
`);
    }

    const comandosBloqueados = [
        "rm ",
        "del ",
        "format",
        "shutdown",
        "restart",
        "powershell -enc",
        "curl ",
        "wget "
    ];

    const lower = comandoShell.toLowerCase();

    if (comandosBloqueados.some(b => lower.includes(b))) {
        return Promise.resolve("Comando bloqueado por segurança.");
    }

    return new Promise((resolve) => {
        exec(
            comandoShell,
            {
                cwd: raizAtlas,
                timeout: 30000,
                maxBuffer: 1024 * 1024
            },
            (erro, stdout, stderr) => {
                registrarAcaoAtlas(
                    "COMANDO EXECUTADO",
                    `COMANDO:\n${comandoShell}\n\nSTATUS:\n${erro ? "Finalizado com erro" : "Finalizado com sucesso"}`
                );

                resolve(`
COMANDO EXECUTADO:
${comandoShell}

PASTA:
${raizAtlas}

SAÍDA:
${stdout || "(sem saída)"}

ERROS:
${stderr || "(sem erros)"}

STATUS:
${erro ? "Finalizado com erro" : "Finalizado com sucesso"}
`);
            }
        );
    });
}

function extrairJson(texto) {
    const limpo = texto
        .replace(/```json/g, "```")
        .replace(/```JSON/g, "```");

    const matchCodigo = limpo.match(/```\n([\s\S]*?)```/);

    if (matchCodigo && matchCodigo[1]) {
        return JSON.parse(matchCodigo[1].trim());
    }

    const inicio = limpo.indexOf("{");
    const fim = limpo.lastIndexOf("}");

    if (inicio !== -1 && fim !== -1 && fim > inicio) {
        return JSON.parse(limpo.slice(inicio, fim + 1));
    }

    throw new Error("Não consegui extrair JSON válido da resposta da IA.");
}

function validarPlanoAgente(plano) {
    if (!plano || !Array.isArray(plano.acoes)) {
        throw new Error("Plano inválido. A propriedade 'acoes' precisa ser uma lista.");
    }

    for (const acao of plano.acoes) {
        const tipo = String(acao.tipo || "").toLowerCase();

        if (!["criar", "editar"].includes(tipo)) {
            throw new Error(`Tipo de ação inválido: ${tipo}`);
        }

        if (!acao.caminho) {
            throw new Error("Existe uma ação sem caminho.");
        }

        validarPodeEditar(acao.caminho);
    }

    return true;
}

async function criarPlanoAgente(comando) {
    const pedido = comando.replace(/^\/agent\s*/i, "").trim();

    if (!pedido) {
        return `
Formato correto:

/agent descreva o que você quer que a ATLAS construa
`;
    }

    const estrutura = listarArquivosRecursivo(raizAtlas, 220);

    const respostaIA = await chamarIA(
        `
Você é a ATLAS em modo agente executor.

O usuário quer:
${pedido}

Você deve criar um plano SEGURO de execução.

REGRAS IMPORTANTES:
- Responda APENAS JSON válido.
- Não use markdown.
- Não explique fora do JSON.
- Nunca edite package.json, .env, package-lock.json, arquivos em node_modules, .git, .vscode, .obsidian ou .atlas-backups.
- Prefira criar arquivos novos em pastas seguras.
- Cada ação deve ter:
  - tipo: "criar" ou "editar"
  - caminho: caminho relativo do arquivo
  - descricao: o que será feito
  - conteudo: conteúdo completo, se tipo for "criar"
  - instrucao: instrução clara, se tipo for "editar"

ESTRUTURA ATUAL DO PROJETO:
${estrutura}

FORMATO EXATO:
{
  "titulo": "nome curto do plano",
  "resumo": "resumo do que será feito",
  "acoes": [
    {
      "tipo": "criar",
      "caminho": "exemplo/arquivo.js",
      "descricao": "criar arquivo exemplo",
      "conteudo": "console.log('exemplo');"
    }
  ]
}
`,
        "gemini"
    );

    let plano;

    try {
        plano = extrairJson(respostaIA);
        validarPlanoAgente(plano);
    } catch (erro) {
        return `
Não consegui montar um plano seguro.

Erro:
${erro.message}

Resposta bruta da IA:
${respostaIA}
`;
    }

    planoPendente = plano;

    const listaAcoes = plano.acoes
        .map((acao, index) => {
            return `${index + 1}. ${String(acao.tipo || "").toUpperCase()} - ${acao.caminho}\n   ${acao.descricao || ""}`;
        })
        .join("\n\n");

    return `
PLANO DO AGENTE CRIADO

TÍTULO:
${plano.titulo || "Plano sem título"}

RESUMO:
${plano.resumo || "Sem resumo."}

AÇÕES:
${listaAcoes}

Para executar, digite:

/confirmar

Para cancelar, digite:

/cancelar
`;
}

async function confirmarPlanoAgente() {
    if (!planoPendente) {
        return "Não existe plano pendente para confirmar.";
    }

    const plano = planoPendente;
    const resultados = [];

    for (const acao of plano.acoes) {
        const tipo = String(acao.tipo || "").toLowerCase();
        const caminho = acao.caminho;

        if (!caminho) {
            resultados.push("Ação ignorada: caminho vazio.");
            continue;
        }

        try {
            validarPodeEditar(caminho);
        } catch (erro) {
            resultados.push(`Bloqueado por segurança: ${caminho}`);
            continue;
        }

        const caminhoFinal = caminhoSeguro(caminho);

        if (tipo === "criar") {
            let backup = null;

            if (fs.existsSync(caminhoFinal)) {
                backup = criarBackup(caminhoFinal, "agent-antes-criar-sobrescrever");
            }

            fs.mkdirSync(path.dirname(caminhoFinal), { recursive: true });
            fs.writeFileSync(caminhoFinal, acao.conteudo || "", "utf8");

            registrarAcaoAtlas(
                "AGENTE CRIOU ARQUIVO",
                `CAMINHO:\n${caminho}\n\nBACKUP:\n${backup || "não existia arquivo anterior"}`
            );

            resultados.push(`Criado: ${caminho}`);
            continue;
        }

        if (tipo === "editar") {
            if (!fs.existsSync(caminhoFinal)) {
                resultados.push(`Não encontrado para editar: ${caminho}`);
                continue;
            }

            const conteudoAtual = fs.readFileSync(caminhoFinal, "utf8");

            const respostaIA = await chamarIA(
                `
Edite este arquivo conforme a instrução.

IMPORTANTE:
- Devolva APENAS o conteúdo final completo.
- Não use markdown.
- Não explique.
- Não apague funcionalidades existentes sem necessidade.
- Preserve o objetivo original do arquivo.

ARQUIVO:
${caminho}

CONTEÚDO ATUAL:
${conteudoAtual}

INSTRUÇÃO:
${acao.instrucao || acao.descricao || "Melhore o arquivo sem alterar seu objetivo."}
`,
                "gemini"
            );

            const novoConteudo = extrairCodigoLimpo(respostaIA);

            if (!novoConteudo.trim()) {
                resultados.push(`Edição cancelada por conteúdo vazio: ${caminho}`);
                continue;
            }

            const backup = criarBackup(caminhoFinal, "agent-antes-editar");

            fs.writeFileSync(caminhoFinal, novoConteudo, "utf8");

            registrarAcaoAtlas(
                "AGENTE EDITOU ARQUIVO",
                `CAMINHO:\n${caminho}\n\nBACKUP:\n${backup || "não criado"}\n\nINSTRUÇÃO:\n${acao.instrucao || acao.descricao || ""}`
            );

            resultados.push(`Editado: ${caminho}`);
            continue;
        }

        resultados.push(`Tipo desconhecido ignorado: ${tipo} em ${caminho}`);
    }

    planoPendente = null;

    return `
PLANO EXECUTADO COM SUCESSO

${resultados.join("\n")}
`;
}

async function agentAuto(comando) {
    const pedido = comando.replace(/^\/agent-auto\s*/i, "").trim();

    if (!pedido) {
        return `
Formato correto:

/agent-auto descreva exatamente o que a ATLAS deve criar ou alterar
`;
    }

    const resumoProjeto = obterResumoProjeto();

    const respostaIA = await chamarIA(
        `
Você é a ATLAS em modo AGENT AUTO.

O usuário quer:
${pedido}

Você deve analisar a estrutura do projeto e executar um plano de alteração de arquivos.

REGRAS DE SEGURANÇA:
- Responda APENAS JSON válido.
- Não use markdown.
- Não explique fora do JSON.
- Nunca altere .env, package-lock.json, arquivos em node_modules, .git, .vscode, .obsidian ou .atlas-backups.
- Evite alterar package.json, a menos que seja absolutamente necessário. Se precisar, não altere: apenas mencione no resumo.
- Prefira criar arquivos novos e seguros.
- Para cada arquivo criado, envie o conteúdo completo.
- Para cada arquivo editado, envie instrução clara.
- Não delete arquivos.
- Não crie scripts perigosos.
- Não use comandos de terminal.

TIPOS ACEITOS:
- "criar"
- "editar"

FORMATO EXATO:
{
  "titulo": "nome curto da tarefa",
  "resumo": "o que será feito",
  "acoes": [
    {
      "tipo": "criar",
      "caminho": "caminho/arquivo.js",
      "descricao": "descrição",
      "conteudo": "conteúdo completo do arquivo"
    },
    {
      "tipo": "editar",
      "caminho": "caminho/existente.js",
      "descricao": "descrição",
      "instrucao": "instrução exata da edição"
    }
  ]
}

PROJETO:
${resumoProjeto}
`,
        "gemini"
    );

    let plano;

    try {
        plano = extrairJson(respostaIA);
        validarPlanoAgente(plano);
    } catch (erro) {
        return `
AGENT AUTO CANCELADO

Não consegui gerar um plano seguro.

ERRO:
${erro.message}

RESPOSTA BRUTA:
${respostaIA}
`;
    }

    planoPendente = plano;

    const previa = plano.acoes
        .map((acao, index) => {
            return `${index + 1}. ${String(acao.tipo || "").toUpperCase()} - ${acao.caminho}\n   ${acao.descricao || ""}`;
        })
        .join("\n\n");

    const resultadoExecucao = await confirmarPlanoAgente();

    registrarAcaoAtlas(
        "AGENT AUTO EXECUTADO",
        `PEDIDO:\n${pedido}\n\nPLANO:\n${JSON.stringify(plano, null, 2)}`
    );

    return `
AGENT AUTO EXECUTADO

TÍTULO:
${plano.titulo || "Sem título"}

RESUMO:
${plano.resumo || "Sem resumo."}

AÇÕES PLANEJADAS:
${previa}

RESULTADO:
${resultadoExecucao}
`;
}

function cancelarPlanoAgente() {
    planoPendente = null;

    return "Plano pendente cancelado.";
}

function generateDiff(originalContent, newContent, filePathA, filePathB) {
    const originalLines = originalContent.split('\n');
    const newLines = newContent.split('\n');
    let diffOutput = `--- a/${filePathA}\n+++ b/${filePathB}\n`;

    let i = 0, j = 0;
    while (i < originalLines.length || j < newLines.length) {
        if (i < originalLines.length && j < newLines.length && originalLines[i] === newLines[j]) {
            diffOutput += `  ${originalLines[i]}\n`;
            i++;
            j++;
        } else {
            if (i < originalLines.length && (j >= newLines.length || originalLines[i] !== newLines[j])) {
                diffOutput += `- ${originalLines[i]}\n`;
                i++;
            }
            if (j < newLines.length && (i >= originalLines.length || originalLines[i] !== newLines[j])) {
                diffOutput += `+ ${newLines[j]}\n`;
                j++;
            }
        }
    }
    return diffOutput;
}

async function diffArquivo(comando) {
    const argumento = comando.replace(/^\/diff-arquivo\s*/i, "").trim();

    if (!argumento) {
        return `
Formato correto:

/diff-arquivo caminho/do/arquivo.js
/diff-arquivo nome-do-backup.bak
/diff-arquivo caminho/do/arquivo.js | nome-do-backup.bak
`;
    }

    let caminhoRelativoA; // Original ou principal
    let caminhoRelativoB; // Comparado (backup ou proposta)
    let conteudoA;
    let conteudoB;
    let labelA = "Arquivo Atual";
    let labelB = "Proposta";

    const partesComando = argumento.split("|").map(p => p.trim());

    try {
        if (partesComando.length === 1) {
            caminhoRelativoA = partesComando[0];

            if (caminhoRelativoA.endsWith(".bak")) {
                const nomeBackup = caminhoRelativoA;
                caminhoRelativoA = extrairArquivoOriginalDoBackup(nomeBackup);
                labelA = `Backup: ${nomeBackup}`;
                conteudoA = fs.readFileSync(path.join(obterPastaBackups(), nomeBackup), 'utf8');
            } else if (edicaoPendente && edicaoPendente.caminhoRelativo === caminhoRelativoA) {
                // Se a edição pendente se refere a este arquivo, comparar com a proposta
                conteudoA = edicaoPendente.conteudoOriginal;
                conteudoB = edicaoPendente.conteudoProposto;
                labelA = `${caminhoRelativoA} (Original)`;
                labelB = `${caminhoRelativoA} (Proposto)`;
            } else {
                // Compara o arquivo atual com seu último backup
                conteudoA = fs.readFileSync(caminhoSeguro(caminhoRelativoA), 'utf8');
                const backups = listarBackups().filter(b => extrairArquivoOriginalDoBackup(b) === caminhoRelativoA);
                if (backups.length > 0) {
                    const ultimoBackupPath = path.join(obterPastaBackups(), backups[0]);
                    conteudoB = fs.readFileSync(ultimoBackupPath, 'utf8');
                    labelB = `Último Backup: ${backups[0]}`;
                } else {
                    return `
Não há backups para comparar com:

${caminhoRelativoA}
`;
                }
            }
        } else if (partesComando.length === 2) {
            caminhoRelativoA = partesComando[0];
            caminhoRelativoB = partesComando[1];

            // Ler conteúdo A
            if (caminhoRelativoA.endsWith(".bak")) {
                conteudoA = fs.readFileSync(path.join(obterPastaBackups(), caminhoRelativoA), 'utf8');
                labelA = `Backup: ${caminhoRelativoA}`;
            } else {
                conteudoA = fs.readFileSync(caminhoSeguro(caminhoRelativoA), 'utf8');
                labelA = `Arquivo: ${caminhoRelativoA}`;
            }

            // Ler conteúdo B
            if (caminhoRelativoB.endsWith(".bak")) {
                conteudoB = fs.readFileSync(path.join(obterPastaBackups(), caminhoRelativoB), 'utf8');
                labelB = `Backup: ${caminhoRelativoB}`;
            } else {
                conteudoB = fs.readFileSync(caminhoSeguro(caminhoRelativoB), 'utf8');
                labelB = `Arquivo: ${caminhoRelativoB}`;
            }
        } else {
            return `
Formato inválido.

/diff-arquivo caminho/do/arquivo.js
/diff-arquivo nome-do-backup.bak
/diff-arquivo caminho/do/arquivo.js | nome-do-backup.bak
`;
        }
    } catch (error) {
        return `Erro ao ler arquivo para diff: ${error.message}`;
    }

    if (conteudoA === undefined || conteudoB === undefined) {
        return "Conteúdo para comparação não encontrado ou inválido.";
    }

    if (conteudoA === conteudoB) {
        return "Os conteúdos são idênticos. Nenhuma diferença encontrada.";
    }

    const diff = generateDiff(conteudoA, conteudoB, labelA, labelB);

    return `
DIFERENÇAS ENCONTRADAS

${diff}
`;
}

function copyRecursiveSync(src, dest, ignoreList) {
    const exists = fs.existsSync(src);
    const stats = exists && fs.statSync(src);
    const isDirectory = exists && stats.isDirectory();

    if (isDirectory) {
        if (ignoreList.some(ignore => src.includes(ignore))) {
            return;
        }
        fs.mkdirSync(dest, { recursive: true });
        fs.readdirSync(src).forEach((childItemName) => {
            copyRecursiveSync(path.join(src, childItemName), path.join(dest, childItemName), ignoreList);
        });
    } else {
        if (ignoreList.some(ignore => src.includes(ignore))) {
            return;
        }
        fs.copyFileSync(src, dest);
    }
}

function criarSnapshot(comando) {
    atualizarRaizAtlas();

    const motivo = comando.replace(/^\/snapshot\s*/i, "").trim() || "manual";
    const pastaBackups = obterPastaBackups();
    const timestamp = new Date()
        .toISOString()
        .replace(/:/g, "-")
        .replace(/\./g, "-");

    const nomeSnapshot = `snapshot__${timestamp}__${motivo}`;
    const caminhoSnapshot = path.join(pastaBackups, nomeSnapshot);

    const ignorePaths = [
        path.join(raizAtlas, "node_modules"),
        path.join(raizAtlas, ".git"),
        path.join(raizAtlas, ".vscode"),
        path.join(raizAtlas, ".atlas-backups"),
        path.join(raizAtlas, ".obsidian"),
        path.join(raizAtlas, ".env"),
        path.join(raizAtlas, "package-lock.json")
    ].map(p => p.toLowerCase());

    try {
        copyRecursiveSync(raizAtlas, caminhoSnapshot, ignorePaths);
        registrarAcaoAtlas(
            "SNAPSHOT CRIADO",
            `NOME:\n${nomeSnapshot}\n\nMOTIVO:\n${motivo}\n\nCAMINHO:\n.atlas-backups/${nomeSnapshot}`
        );
        return `
Snapshot criado com sucesso.

NOME:
${nomeSnapshot}

MOTIVO:
${motivo}

CAMINHO:
.atlas-backups/${nomeSnapshot}
`;
    } catch (error) {
        return `Erro ao criar snapshot: ${error.message}`;
    }
}


async function gerarResposta(texto) {
    atualizarRaizAtlas();

    const comando = texto.trim();

    if (!comando) return "Digite um comando ou uma mensagem.";

    if (comando === "/help") {
        return `
COMANDOS DA ATLAS

GERAIS:
/help
/status
/plugins
/memoria
/salvar-memoria texto
/arquivo-atual
/selecao
/listar-arquivos
/listar-pastas
/buscar-texto termo

ARQUIVOS:
/abrir caminho
/abrir-multiplos arquivo1 | arquivo2 | arquivo3
/ler-arquivo caminho
/criar-arquivo caminho | conteúdo
/editar-arquivo caminho | instrução
/escrever-arquivo caminho
CONTEÚDO COMPLETO DO ARQUIVO
/substituir-texto arquivo | texto antigo | texto novo
/deletar-arquivo caminho
/restaurar-backup
/restaurar-backup nome-do-backup
/diff-arquivo [caminho/do/arquivo.js | nome-do-backup.bak | caminho/arquivo.js | nome-backup.bak]
/snapshot [motivo]

EDIÇÃO PENDENTE:
/confirmar-edicao
/cancelar-edicao

TERMINAL:
/terminal comando
/rodar comando
/executar comando

IA:
/chatgpt pergunta
/gemini pergunta
/atlas pergunta
/ia-arquivo pergunta
/ia-selecao pergunta
/gerar-codigo pedido

AGENTE:
/agent pedido complexo
/agent-auto pedido complexo
/confirmar
/cancelar

VERSÃO FINAL:
- Edição pendente com confirmação
- /agent-auto robusto
- /diff-arquivo
- /snapshot
- Logs e backups aprimorados
`;
    }

    if (comando === "/status") {
        return `
STATUS DA ATLAS - Versão Final

- Painel interno do VS Code ativo
- Gemini: ${geminiModel ? "conectado" : "não conectado"}
- OpenAI: ${openaiClient ? "conectada, mas pode estar sem quota/billing" : "não conectada"}
- Fallback OpenAI → Gemini: ativo
- Executor local: ativo
- Modo agente: ativo com confirmação
- Agent Auto: ativo
- Edição Pendente: ${edicaoPendente ? `SIM para ${edicaoPendente.caminhoRelativo}` : "NÃO"}
- Comandos operacionais: ativos
- Memória local: ativa
- Backup automático: ativo
- Log de ações: ativo
- Raiz ATLAS: ${raizAtlas}
`;
    }

    if (comando === "/plugins") {
        return `
PLUGINS

- dev
- obsidian
- system
`;
    }

    if (comando === "/memoria") {
        const memoria = carregarMemoria();

        if (!memoria.trim()) return "Nenhuma memória markdown encontrada.";

        return `
MEMÓRIA CARREGADA

Caracteres carregados:
${memoria.length}

Raiz:
${raizAtlas}
`;
    }

    if (comando.startsWith("/salvar-memoria ")) {
        return salvarMemoria(comando);
    }

    if (comando === "/arquivo-atual") {
        const editor = obterEditor();

        if (!editor) return "Nenhum arquivo aberto.";

        const documento = editor.document;

        return `
ARQUIVO ATUAL

Nome:
${documento.fileName}

Linguagem:
${documento.languageId}

Linhas:
${documento.lineCount}
`;
    }

    if (comando === "/selecao") {
        const dadosSelecao = obterSelecaoAtual();

        if (!dadosSelecao) return "Nenhum texto selecionado.";

        return `
SELEÇÃO ATUAL

${dadosSelecao.textoSelecionado}
`;
    }

    if (comando.startsWith("/listar-arquivos")) {
        const pasta = comando.replace(/^\/listar-arquivos\s*/i, "").trim() || ".";
        const caminhoPasta = caminhoSeguro(pasta);

        if (!fs.existsSync(caminhoPasta)) {
            return `
Pasta não encontrada:

${pasta}

Raiz atual:
${raizAtlas}
`;
        }

        return `
ARQUIVOS ENCONTRADOS:

${listarArquivosRecursivo(caminhoPasta)}
`;
    }

    if (comando.startsWith("/listar-pastas")) {
        const pasta = comando.replace(/^\/listar-pastas\s*/i, "").trim() || ".";
        const caminhoPasta = caminhoSeguro(pasta);

        if (!fs.existsSync(caminhoPasta)) {
            return `
Pasta não encontrada:

${pasta}

Raiz atual:
${raizAtlas}
`;
        }

        return `
PASTAS ENCONTRADAS:

${listarPastasRecursivo(caminhoPasta)}
`;
    }

    if (comando.startsWith("/buscar-texto ")) {
        const termo = comando.replace(/^\/buscar-texto\s*/i, "").trim();

        const resultados = buscarTextoRecursivo(raizAtlas, termo);

        if (!resultados.length) {
            return `Nenhum arquivo encontrado com o termo: ${termo}`;
        }

        return `
TERMO BUSCADO:
${termo}

RAIZ:
${raizAtlas}

ARQUIVOS ENCONTRADOS:
${resultados.join("\n")}
`;
    }

    if (comando.startsWith("/abrir-multiplos ")) {
        return await abrirMultiplosArquivos(comando);
    }

    if (comando.startsWith("/abrir ")) {
        return await abrirArquivo(comando);
    }

    if (comando.startsWith("/ler-arquivo ")) {
        return lerArquivo(comando);
    }

    if (comando.startsWith("/criar-arquivo ")) {
        return await criarArquivo(comando);
    }

    if (comando.startsWith("/editar-arquivo ")) {
        return await editarArquivo(comando);
    }

    if (comando === "/confirmar-edicao") {
        return await confirmarEdicaoPendente();
    }

    if (comando === "/cancelar-edicao") {
        return cancelarEdicaoPendente();
    }

    if (comando.startsWith("/escrever-arquivo ")) {
        return await escreverArquivoCompleto(comando);
    }

    if (comando.startsWith("/deletar-arquivo ")) {
        return deletarArquivo(comando);
    }

    if (comando.startsWith("/substituir-texto ")) {
        return substituirTexto(comando);
    }

    if (comando === "/restaurar-backup" || comando === "/backups" || comando.startsWith("/restaurar-backup ")) {
        return await restaurarBackup(comando.replace(/^\/backups/i, "/restaurar-backup"));
    }

    if (comando.startsWith("/diff-arquivo ")) {
        return await diffArquivo(comando);
    }

    if (comando.startsWith("/snapshot") || comando === "/snapshot") {
        return criarSnapshot(comando);
    }

    if (comando.startsWith("/terminal ")) {
        return await executarComando(comando, "/terminal");
    }

    if (comando.startsWith("/rodar ")) {
        return await executarComando(comando, "/rodar");
    }

    if (comando.startsWith("/executar ")) {
        return await executarComando(comando, "/executar");
    }

    if (comando.startsWith("/agent-auto ")) {
        return await agentAuto(comando);
    }

    if (comando.startsWith("/agent ")) {
        return await criarPlanoAgente(comando);
    }

    if (comando === "/confirmar") {
        return await confirmarPlanoAgente();
    }

    if (comando === "/cancelar") {
        return cancelarPlanoAgente();
    }

    if (
        comando.startsWith("/chatgpt ") ||
        comando.startsWith("/gemini ") ||
        comando.startsWith("/atlas ")
    ) {
        const provider = identificarProvider(comando);
        const pergunta = limparComandoIA(comando);

        return await chamarIA(pergunta, provider);
    }

    if (comando.startsWith("/ia-arquivo ")) {
        const editor = obterEditor();

        if (!editor) return "Nenhum arquivo aberto.";

        const documento = editor.document;
        const codigo = documento.getText();
        const pergunta = comando.replace("/ia-arquivo ", "");

        const promptUsuario = `
Analise este arquivo aberto no VS Code.

ARQUIVO:
${documento.fileName}

LINGUAGEM:
${documento.languageId}

CÓDIGO:
${codigo}

PERGUNTA:
${pergunta}
`;

        return await chamarIA(promptUsuario, "gemini");
    }

    if (comando.startsWith("/ia-selecao ")) {
        const dadosSelecao = obterSelecaoAtual();

        if (!dadosSelecao) return "Nenhum texto selecionado.";

        const documento = dadosSelecao.editor.document;
        const pergunta = comando.replace("/ia-selecao ", "");

        const promptUsuario = `
Analise apenas este trecho selecionado no VS Code.

ARQUIVO:
${documento.fileName}

LINGUAGEM:
${documento.languageId}

TRECHO:
${dadosSelecao.textoSelecionado}

PERGUNTA:
${pergunta}
`;

        return await chamarIA(promptUsuario, "gemini");
    }

    if (comando.startsWith("/gerar-codigo ")) {
        const promptUsuario = comando.replace("/gerar-codigo ", "");

        return await chamarIA(
            `
Gere código completo para este pedido:

${promptUsuario}
`,
            "gemini"
        );
    }

    return await chamarIA(comando, "gemini");
}

function getWebviewContent() {
    return `
<!DOCTYPE html>
<html lang="pt-br">

<head>
<meta charset="UTF-8">

<style>
* { box-sizing: border-box; }

body {
    background: #050816;
    color: white;
    font-family: Arial, sans-serif;
    padding: 20px;
}

h1 {
    color: #00e5ff;
